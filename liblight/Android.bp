cc_library_shared {
    name: "lights.wahoo",

    srcs: ["lights.c"],
    relative_install_path: "hw",
    proprietary: true,
    header_libs: ["libhardware_headers"] + ["generated_kernel_headers"],
    shared_libs: [
        "libc",
        "libcutils",
        "liblog",
    ],
    cflags: common_flags + [
        "-DLOG_TAG=\"qdlights\"",
        "-DDEFAULT_LOW_PERSISTENCE_MODE_BRIGHTNESS=" + DEFAULT_LOW_PERSISTENCE_MODE_BRIGHTNESS,
    ] + [
        "-Wall",
        "-Werror",
    ],

}
